<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin</title>
  <link href="styles/admin-styles.css" rel="stylesheet">
</head>

<body>
  <table id="order-table" class="display">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Method</th>
        <th>Toppings</th>
        <th>Size</th>
        <th>Comment</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(order => {%>
        <tr>
            <td><%=order.fname%> <%=order.lname%></td>
            <td><%=order.email%></td>
            <td><%=order.method%></td>
            <td><%=order.toppings%></td>
            <td><%=order.size%></td>
            <td><%=order.comment%></td>
            <td><%=order.timestamp.toLocaleString()%></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>

</html>